---
import Base from '../layouts/Base.astro';
import { bands } from '../data/profile';
---
<Base title="Bands">
  <h1>Bands</h1>
  <ul class="cards">
    {bands.map((b) => (
      <li class="card">
        <h2><a href={b.url}>{b.name}</a></h2>
        {b.role && <p class="muted">{b.role}</p>}
        {b.description && <p>{b.description}</p>}
        <p class="muted">{new URL(b.url).hostname}</p>
      </li>
    ))}
  </ul>
</Base>
