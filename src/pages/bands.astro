---
import Base from '../layouts/Base.astro';
import { bands } from '../data/profile';
---
<Base title="Bands">
  <h1>Bands</h1>
  {bands.length === 0 ? (
    <p class="muted">Coming soon.</p>
  ) : (
    <ul class="cards">
      {bands.map((b) => (
        <li class="card">
          <h2>{b.url ? <a href={b.url}>{b.name}</a> : b.name}</h2>
          <p class="muted">{b.role}</p>
          <p>{b.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
