---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<Base>
  <section class="hero">
    <img class="avatar" src={profile.avatar} alt={profile.name} width="140" height="148" />
    <div>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.title}</p>
      <p>{profile.bio}</p>
      <p class="links">
        {profile.links.map((l) => <a href={l.href} rel="me">{l.label}</a>)}
      </p>
    </div>
  </section>

  <section>
    <h2>Recent posts</h2>
    <ul class="cards">
      {posts.map((p) => (
        <li class="card">
          <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
          <time class="muted" datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en-GB', { dateStyle: 'long' })}</time>
          <p>{p.data.summary}</p>
        </li>
      ))}
    </ul>
    <p><a href="/blog">All posts →</a></p>
  </section>
</Base>
