---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { profile, work, education } from '../data/profile';
---
<Base>
  <section class="hero">
    <img class="avatar" src={profile.avatar} alt={profile.name} width="140" height="148" />
    <div>
      <h1>{profile.name}</h1>
      <p class="lead">{profile.title} · {profile.location}</p>
      <p>{profile.bio}</p>
      <p class="links">
        {profile.links.map((l) => <a href={l.href} rel={l.href.startsWith("mailto:") ? undefined : "me"}>{l.label}</a>)}
      </p>
    </div>
  </section>

  <h2>Work experience</h2>
  <ul class="entries">{work.map((e) => <Entry {...e} />)}</ul>

  <h2>Education</h2>
  <ul class="entries">{education.map((e) => <Entry {...e} />)}</ul>

  <h2>Skills</h2>
  {profile.skills.map((s) => (
    <p><strong>{s.group}:</strong> {s.items.join(', ')}</p>
  ))}
</Base>
