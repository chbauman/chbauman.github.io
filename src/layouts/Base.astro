---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = `${profile.name} – ${profile.title} in ${profile.location}.`, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} – ${profile.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/img/og-image.png', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  url: Astro.site?.href,
  image: new URL(profile.avatar, Astro.site).href,
  address: { '@type': 'PostalAddress', addressCountry: 'CH' },
  sameAs: profile.links.filter((l) => l.href.startsWith('http')).map((l) => l.href),
};
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/bands', label: 'Bands' },
  { href: '/contact', label: 'Contact' },
];
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/img/favicon.ico" />
    <title>{fullTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">{profile.name}</a>
      <nav aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <main class="container"><slot /></main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {profile.name}</p>
    </footer>
  </body>
</html>
