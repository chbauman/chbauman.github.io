---
interface Props { org: string; logo: string; url: string; role: string; description: string }
const { org, logo, url, role, description } = Astro.props;
---
<li class="entry">
  <img src={logo} alt="" width="56" height="56" loading="lazy" />
  <div>
    <h3>{role}</h3>
    <p><a href={url}>{org}</a></p>
    <p class="muted">{description}</p>
  </div>
</li>
